@using HospitalManagementSystem.Presentation.Areas.Admin.Models
@model List<PatientVM>

<div class="container-fluid">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">All Patients</div>
                    </div>
                    <div class="card-body">
                        <table id="docTable" class="display" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>BirthDate</th>
@*                                     <th>Age</th>
 *@                                    <th>GenderType</th>
                                    <th>Address</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int c = 1;
                                }
                                @foreach (var d in Model)
                                {
                                    <tr>
                                        <td>@c</td>
                                        <td>@d.Name</td>
                                        <td>@d.PhoneNumber</td>
                                        <td>@d.BirthDate.ToString("dd/MM/yyyy")</td>
@*                                         <th>@d.Age</th>
 *@                                        <td>@d.GenderType.ToString()</td>
                                        <td>@d.Address</td>
                                        <td>
                                            <a href="javascript:void(0);" class="btn btn-success" onclick="window.location.href='@Url.Action("EditPatient", "Patient", new { id = d.Id })';">Edit</a>
                                            <a href="Admin/Patient/DeletePatient/@d.Id" class="btn btn-danger">Delete</a>
                                        </td>
                                    </tr>
                                    c++;
                                }
                            </tbody>
                        </table>



                    </div>


                </div>
            </div>

        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
      $('#docTable').DataTable({
        paging: true,
        pageLength: 10,
        lengthMenu: [5,10,25],
        ordering: true,
        searching: true
      });
    });
</script>
