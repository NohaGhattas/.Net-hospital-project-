@using HospitalManagementSystem.Presentation.Areas.Admin.Models
@model List<DoctorVM>

<div class="container-fluid">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">All Doctors</div>
                    </div>
                    <div class="card-body">
                        <table id="docsTable" class="display" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Specialization</th>
                                    <th>Speciality Level</th>
                                    <th>Photo</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int c = 1;
                                }
                                @foreach (var d in Model)
                                {
                                    <tr>
                                        <td>@c</td>
                                        <td>@d.Name</td>
                                        <td>@d.Phone</td>
                                        <td>@d.Specialization</td>
                                        <td>@d.SpecialityLevel</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(d.ImageURL))
                                            {
                                                <img src="@d.ImageURL" alt="Photo" width="60" />
                                            }
                                        </td>
                                        <td>
                                            <a href="javascript:void(0);" class="btn btn-success" onclick="window.location.href='@Url.Action("EditDoctor", "Doctor", new { id = d.Id })';">Edit</a>
                                            <a href="Admin/Doctor/DeleteDoctor/@d.Id" class="btn btn-danger">Delete</a>
                                        </td>
                                    </tr>
                                    c++;
                                }
                            </tbody>
                        </table>



                    </div>


                </div>
            </div>
            
        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
      $('#docsTable').DataTable({
        paging: true,           
        pageLength: 10,         
        lengthMenu: [5,10,25],
        ordering: true,         
        searching: true         
      });
    });
</script>
