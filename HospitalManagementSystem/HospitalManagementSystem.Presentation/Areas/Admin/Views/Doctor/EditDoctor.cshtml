@using HospitalManagementSystem.Presentation.Areas.Admin.Models
@model DoctorVM

<div class="container-fluid">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Edit Doctor</div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 col-lg-6">
                                <div class="form-group">
                                    <input type="text" asp-for="@Model.Id"  class="form-control" id="id" hidden/>
                                </div>
                                <div class="form-group">
                                    <label for="name1">Name</label>
                                    <input type="text" asp-for="@Model.Name" value="@Model.Name" class="form-control" id="name1"  />
                                </div>

                                <div class="form-group">
                                    <label for="spec">Specialization</label>
                                    <input type="text" asp-for="@Model.Specialization" value="@Model.Specialization" class="form-control" id="spec" />
                                </div>
                                <div class="form-group">
                                    <label for="stat">Status</label>
                                    <input type="text" asp-for="@Model.Status" value="@Model.Status" class="form-control" id="stat"  />
                                </div>
                                <div class="form-group">
                                    <label for="phone">Phone Number</label>
                                    <input type="text" asp-for="@Model.Phone" value="@Model.Phone"class="form-control" id="phone"  />
                                </div>

                                <div class="form-group">
                                    <label for="exampleFormControlSelect1">Department</label>
                                    <select class="form-select"
                                            id="exampleFormControlSelect1">
                                        <option>1</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                        <option>5</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="exampleFormControlFile1">Image</label>
                                    <input type="file"
                                           class="form-control-file"
                                           id="exampleFormControlFile1"
                                           asp-for="@Model.Image" />
                                           <img src="@Model.ImageURL" />
                                </div>


                            </div>

                        </div>


                    </div>


                </div>
            </div>
            <div class="card-action">
                <button class="btn btn-success">Submit</button>
                <button class="btn btn-danger">Cancel</button>
            </div>
        </div>
    </div>
</div>


