@using HospitalManagementSystem.Presentation.Areas.Admin.Models
@model DepartmentVM

<div class="container-fluid">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">New Department</div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 col-lg-6">
                                <form asp-action="EditDepartment" method="post" enctype="multipart/form-data">
                                    <div class="form-group">
                                        <label for="name1">Name</label>
                                        <input type="text" asp-for="@Model.Name" value="@Model.Name" class="form-control" id="name1"  />
                                    </div>

                                    <div class="form-group">
                                        <label for="des">Description</label>
                                        <input type="text" asp-for="@Model.Description" value="@Model.Description" class="form-control" id="des" />
                                    </div>
                                    <div class="card-action">

                                        <button type="submit" class="btn btn-success">Submit</button>
                                        <button asp-area="Admin" asp-action="AllDepartments" asp-controller="Department" class="btn btn-danger">Cancel</button>
                                    </div>
                                </form>



                            </div>

                        </div>


                    </div>


                </div>
            </div>

        </div>
    </div>
</div>


