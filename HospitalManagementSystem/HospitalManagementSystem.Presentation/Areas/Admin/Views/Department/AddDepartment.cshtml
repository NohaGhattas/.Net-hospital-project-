@using HospitalManagementSystem.Presentation.Areas.Admin.Models
@model DepartmentVM

<div class="container-fluid">
    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">New Department</div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 col-lg-6">
                                <form asp-area="Admin" asp-controller="Department" asp-action="AddDepartment" method="post">
                                    @Html.AntiForgeryToken()

                                    <div class="form-group">
                                        <label for="name1">Name</label>
                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @id = "name1", placeholder = "Enter department name" })
                                    </div>

                                    <div class="form-group">
                                        <label for="des">Description</label>
                                        @Html.TextBoxFor(model => model.Description, new { @class = "form-control", @id = "des", placeholder = "Enter description" })
                                    </div>

                                    <div class="card-action">
                                        <button type="submit" class="btn btn-success">Submit</button>
                                        <a asp-area="Admin" asp-action="AllDepartments" asp-controller="Department" class="btn btn-danger">Cancel</a>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
