@model HospitalManagementSystem.Presentation.ViewModels.ContactUsViewModel

@{
    ViewData["Title"] = "Contact Us";
}

<style>
    .social-icon:hover {
        transform: scale(1.2);
        transition: transform 0.3s ease;
    }
</style>

<div class="container mt-5 text-end">
    <h1 class="mb-4">Contact us</h1>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <h3>Address</h3>
            <p style="margin-left: 8px; font-size: 18px;">@Model.Address</p>

            <h3 class="me-2 mb-0">Hotline</h3>
            <a href="https://wa.me/@(Model.Phone.Replace(" ", "").Replace("+", ""))" target="_blank" class="text-decoration-none d-flex align-items-center mb-4">
                <span style="font-size: 18px; color: #212529; margin-left: 8px;">@Model.Phone</span>
                <i class="fab fa-whatsapp text-success social-icon" style="font-size: 24px;margin-left: 6px;"></i>
            </a>

            <h3>Working Hours</h3>
            <p style="margin-left: 8px; font-size: 18px;">24 hours</p>

            <h3>Follow Us</h3>
            <a href="@Model.Twitter" target="_blank">
                <i class="fab fa-twitter me-1 social-icon" style="font-size: 28px; color: #0d6efd; margin-left: 6px;"></i>
            </a>
            <a href="@Model.Facebook" target="_blank" class="me-4">
                <i class="fab fa-facebook-f me-1 social-icon" style="font-size: 28px; color: #0d6efd; margin-left: 8px;"></i>
            </a>
            <a href="@Model.LinkedIn" target="_blank">
                <i class="fab fa-instagram me-1 social-icon" style="font-size: 28px; color: #0d6efd; margin-left: 6px;"></i>
            </a>
        </div>

        <div class="col-md-6">
            <div class="embed-responsive embed-responsive-16by9">
                <iframe src="@Model.Location"
                        width="100%"
                        height="300"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}

