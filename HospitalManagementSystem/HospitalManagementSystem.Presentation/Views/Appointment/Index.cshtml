@model HospitalManagementSystem.Presentation.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-6 d-none d-lg-block text-center">
            <img src="~/Images/img/gallery/contact_form.png" alt="Contact Form" class="img-fluid" />
        </div>

        <div class="col-lg-6">
            <form asp-action="Index" asp-controller="Appointment" method="post">
                <div class="form-group mb-4">
                    <label for="doctorName" class="form-label">Doctor Name</label>
                    <input type="text" asp-for="DoctorName" id="doctorName" class="form-control uniform-input" readonly />
                </div>

                <div class="form-group mb-4">
                    <label for="speciality" class="form-label">Speciality</label>
                    <input type="text" asp-for="Specialization" id="speciality" class="form-control uniform-input" readonly />
                </div>

                <div class="form-group mb-4">
                    <label for="PatientTitle" class="form-label">Title</label>
                    <select asp-for="PatientTitle" id="PatientTitle" class="form-control uniform-input" required>
                        <option value="">Select Title</option>
                        <option>Mr</option>
                        <option>Mrs</option>
                        <option>Ms</option>
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label for="patientName" class="form-label">Patient Name</label>
                    <input type="text" id="patientName" name="PatientName" class="form-control uniform-input" required />
                </div>

                <div class="form-group mb-4">
                    <label for="phone" class="form-label">Phone</label>
                    <input type="tel" id="phone" name="Phone" class="form-control uniform-input" required />
                </div>

                <div class="form-group mb-4">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" asp-for="Email" class="form-control uniform-input" required />
                </div>

                <div class="form-group mb-4">
                    <label for="dob" class="form-label">Date of Birth</label>
                    <input type="date" id="dob" name="DateOfBirth" class="form-control uniform-input" required />
                </div>

                <div class="form-group mb-4">
                    <label for="gender" class="form-label">Gender</label>
                    <select id="gender" name="Gender" class="form-control uniform-input" required>
                        <option value="">Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label for="doa" class="form-label">Date of Appointment</label>
                    <input type="date" id="doa" name="DateOfAppointment" class="form-control uniform-input" required />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary uniform-input">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-label {
        display: block;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-control {
        display: block;
        width: 100%;
        margin-bottom: 10px;
    }

    .uniform-input {
        height: 45px;
        font-size: 16px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .btn-primary {
        width: 100%;
    }
</style>