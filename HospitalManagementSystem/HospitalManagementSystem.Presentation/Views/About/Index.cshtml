@model HospitalManagementSystem.Presentation.ViewModels.AboutViewModel
@{
    ViewData["Title"] = "About";
}
<div class="about-page">
    <div class="about-container">
        <div class="about-content">
            <h1>@Model.Title</h1>
            <p>@Model.Description</p>
        </div>
        <div class="about-image">
            <img src="@Model.ImageUrl" alt="Hospital Photo" />
        </div>
    </div>
</div>

<style>
    .about-page {
        margin: 20px;
        font-family: Arial, sans-serif;
    }

    .about-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 50px;
        margin-left: 100px;
        margin-right: 75px;
    }

    .about-content {
        max-width: 50%;
        text-align: left;
    }

    .about-content h1 {
        font-size: 2.5rem;
        color: #333;
        margin-bottom: 10px;
    }

    .about-content p {
        font-size: 1.5rem;
        color: #555;
        line-height: 1.6;
    }

    .about-image img {
        max-width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 10px;
    }
</style>